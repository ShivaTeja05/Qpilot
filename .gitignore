# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Data: the demo dataset is fetched at runtime and never committed
*.rdml
!tests/fixtures/*.rdml
# The public instrument-export corpus: small files, byte-identical to source, listed in MANIFEST.yaml.
!tests/fixtures/corpus/**/*.rdml
# The Decision Simulator's validation plates are small public files, committed with provenance.
!sim/data/**/*.rdml
.cache/
*.tmp

# Local outputs
/out/
/records/
*.zip
sbom.json

# OS / editors
.DS_Store
.idea/
.vscode/

# The online demo: its build (npm run build:demo) and the assembled site
frontend/dist-demo/
/site/*
!/site/vercel.json
!/site/README.md
